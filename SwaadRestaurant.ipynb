    "# ==========================================================\n",
    "#            RESTAURANT ASSISTANT CLASS (CELL 4)\n",
    "# ==========================================================\n",
    "\n",
    "class RestaurantAssistant:\n",
    "\n",
    "    def __init__(self):\n",
    "\n",
    "        self.language = \"en\"\n",
    "\n",
    "        # -----------------------------\n",
    "        # Edge-TTS Voices\n",
    "        # -----------------------------\n",
    "        self.voices = {\n",
    "\n",
    "            \"en\": \"en-IN-NeerjaNeural\",\n",
    "\n",
    "            \"hi\": \"hi-IN-SwaraNeural\",\n",
    "\n",
    "            # Assamese uses Bengali voice\n",
    "            \"as\": \"bn-IN-TanishaaNeural\"\n",
    "\n",
    "        }\n",
    "\n",
    "        # -----------------------------\n",
    "        # Google Speech Recognition\n",
    "        # -----------------------------\n",
    "        self.language_codes = {\n",
    "\n",
    "            \"en\": \"en-IN\",\n",
    "\n",
    "            \"hi\": \"hi-IN\",\n",
    "\n",
    "            # Closest available language\n",
    "            \"as\": \"bn-IN\"\n",
    "\n",
    "        }\n",
    "\n",
    "        self.recognizer = sr.Recognizer()\n",
    "\n",
    "        self.device_index = 1\n",
    "\n",
    "        self.recognizer.pause_threshold = 1.8\n",
    "\n",
    "        self.recognizer.energy_threshold = 500\n",
    "\n",
    "        self.recognizer.dynamic_energy_threshold = True\n",
    "           \n",
    "\n",
    "    # ======================================================\n",
    "    # Generate Speech\n",
    "    # ======================================================\n",
    "\n",
    "    async def _generate_audio(self, text):\n",
    "\n",
    "        temp = tempfile.NamedTemporaryFile(\n",
    "\n",
    "            delete=False,\n",
    "\n",
    "            suffix=\".mp3\"\n",
    "\n",
    "        )\n",
    "\n",
    "        filename = temp.name\n",
    "\n",
    "        temp.close()\n",
    "\n",
    "        communicate = edge_tts.Communicate(\n",
    "\n",
    "            text=text,\n",
    "\n",
    "            voice=self.voices[self.language]\n",
    "\n",
    "        )\n",
    "\n",
    "        await communicate.save(filename)\n",
    "\n",
    "        return filename\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # Speak\n",
    "    # ======================================================\n",
    "\n",
    "    def speak(self, text):\n",
    "\n",
    "        print(\"\\n\" + \"=\" * 60)\n",
    "\n",
    "        print(\"🤖 Assistant\")\n",
    "\n",
    "        print(\"-\" * 60)\n",
    "\n",
    "        print(text)\n",
    "\n",
    "        print(\"=\" * 60)\n",
    "\n",
    "        filename = None\n",
    "\n",
    "        try:\n",
    "\n",
    "            filename = asyncio.run(\n",
    "\n",
    "                self._generate_audio(text)\n",
    "\n",
    "            )\n",
    "\n",
    "            pygame.mixer.music.load(filename)\n",
    "\n",
    "            pygame.mixer.music.play()\n",
    "\n",
    "            while pygame.mixer.music.get_busy():\n",
    "\n",
    "                pygame.time.Clock().tick(10)\n",
    "\n",
    "            pygame.mixer.music.unload()\n",
    "\n",
    "        except Exception as e:\n",
    "\n",
    "            print(f\"⚠️ Audio Error: {e}\")\n",
    "\n",
    "        finally:\n",
    "\n",
    "            if filename and os.path.exists(filename):\n",
    "\n",
    "                try:\n",
    "\n",
    "                    os.remove(filename)\n",
    "\n",
    "                except Exception:\n",
    "\n",
    "                    pass\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # Listen\n",
    "    # ======================================================\n",
    "\n",
    "    def listen(self, timeout=5, phrase_time_limit=5):\n",
    "    \n",
    "        try:\n",
    "    \n",
    "            with sr.Microphone(device_index=self.device_index) as source:\n",
    "    \n",
    "                print(\"\\n🎤 Listening...\")\n",
    "    \n",
    "                self.recognizer.adjust_for_ambient_noise(source, duration=0.3)\n",
    "    \n",
    "                audio = self.recognizer.listen(\n",
    "                    source,\n",
    "                    timeout = timeout,\n",
    "                    phrase_time_limit = phrase_time_limit\n",
    "                )\n",
    "                    \n",
    "            print(\"🔄 Recognizing...\")\n",
    "    \n",
    "            text = self.recognizer.recognize_google(\n",
    "                audio,\n",
    "                language=self.language_codes[self.language]\n",
    "            )\n",
    "    \n",
    "            print(\"\\n👤 You :\", text)\n",
    "    \n",
    "            return text.lower().strip()\n",
    "    \n",
    "        except sr.UnknownValueError:\n",
    "            print(\"⚠️ Could not understand speech.\")\n",
    "            return \"\"\n",
    "        \n",
    "        except sr.RequestError as e:\n",
    "            print(\"Google Speech Recognition error:\", e)\n",
    "            return \"\"\n",
    "        \n",
    "        except Exception as e:\n",
    "            print(type(e).__name__)\n",
    "            print(e)\n",
    "            return \"\"\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # Change Language\n",
    "    # ======================================================\n",
    "\n",
    "    def set_language(self, language):\n",
    "\n",
    "        if language in self.voices:\n",
    "\n",
    "            self.language = language\n",
    "\n",
    "            return True\n",
    "\n",
    "        return False\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # Speak using TEXT dictionary\n",
    "    # ======================================================\n",
    "\n",
    "    def say(self, key):\n",
    "\n",
    "        self.speak(TEXT[self.language][key])\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # Ask Yes / No Question\n",
    "    # ======================================================\n",
    "\n",
    "    def ask_yes_no(self, question_key):\n",
    "\n",
    "        self.say(question_key)\n",
    "\n",
    "        reply = self.listen()\n",
    "\n",
    "        if not reply:\n",
    "\n",
    "            return False\n",
    "\n",
    "        if any(word in reply for word in TEXT[self.language][\"yes\"]):\n",
    "\n",
    "            return True\n",
    "\n",
    "        if any(word in reply for word in TEXT[self.language][\"no\"]):\n",
    "\n",
    "            return False\n",
    "\n",
    "        return False\n",
    "\n",
    "\n",
