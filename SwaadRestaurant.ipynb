    "# ----------------------------------------------------------\n",
    "# BUILD KEYWORD DICTIONARY\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "ITEM_KEYWORDS = {}\n",
    "\n",
    "for item, details in MENU.items():\n",
    "\n",
    "    ITEM_KEYWORDS[item] = item\n",
    "\n",
    "    for keyword in details[\"keywords\"]:\n",
    "\n",
    "        ITEM_KEYWORDS[keyword.lower()] = item\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# QUANTITY DETECTION\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "def get_quantity(word):\n",
    "\n",
    "    word = word.lower().strip()\n",
    "\n",
    "    if word.isdigit():\n",
    "\n",
    "        return int(word)\n",
    "\n",
    "    return NUMBER_WORDS.get(word)\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# PREPROCESS RECOGNIZED TEXT\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "def preprocess_text(text):\n",
    "\n",
    "    words = text.split()\n",
    "\n",
    "    corrected = []\n",
    "\n",
    "    for word in words:\n",
    "\n",
    "        corrected.append(\n",
    "\n",
    "            WORD_CORRECTIONS.get(word, word)\n",
    "\n",
    "        )\n",
    "\n",
    "    return \" \".join(corrected)\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# FUZZY ITEM MATCHING\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "def match_item(word):\n",
    "\n",
    "    word = word.lower().strip()\n",
    "\n",
    "    if word in ITEM_KEYWORDS:\n",
    "\n",
    "        return ITEM_KEYWORDS[word]\n",
    "\n",
    "\n",
    "    IGNORE_WORDS = {\n",
    "\n",
    "        \"i\",\n",
    "        \"me\",\n",
    "        \"my\",\n",
    "        \"want\",\n",
    "        \"need\",\n",
    "        \"please\",\n",
    "        \"give\",\n",
    "        \"bring\",\n",
    "        \"serve\",\n",
    "        \"get\",\n",
    "        \"can\",\n",
    "        \"have\",\n",
    "        \"to\",\n",
    "        \"for\",\n",
    "        \"the\",\n",
    "        \"this\",\n",
    "        \"that\",\n",
    "        \"thanks\",\n",
    "\n",
    "        \"mujhe\",\n",
    "        \"chahiye\",\n",
    "        \"dijiye\",\n",
    "        \"do\",\n",
    "\n",
    "        \"mok\",\n",
    "        \"diyok\",\n",
    "        \"lagibo\",\n",
    "\n",
    "        \"aur\",\n",
    "        \"and\"\n",
    "\n",
    "    }\n",
    "\n",
    "    if word in IGNORE_WORDS:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "    matches = get_close_matches(\n",
    "\n",
    "        word,\n",
    "\n",
    "        ITEM_KEYWORDS.keys(),\n",
    "\n",
    "        n=1,\n",
    "\n",
    "        cutoff=0.75\n",
    "\n",
    "    )\n",
    "\n",
    "    if matches:\n",
    "\n",
    "        return ITEM_KEYWORDS[matches[0]]\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# COMMAND DETECTION\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "def detect_command(text):\n",
    "\n",
    "    text = text.lower()\n",
    "\n",
    "    for word in REMOVE_WORDS:\n",
    "\n",
    "        if word in text:\n",
    "\n",
    "            return \"remove\"\n",
    "\n",
    "    for word in SHOW_MENU_WORDS:\n",
    "\n",
    "        if word in text:\n",
    "\n",
    "            return \"menu\"\n",
    "\n",
    "    for word in PRICE_WORDS:\n",
    "\n",
    "        if word in text:\n",
    "\n",
    "            return \"price\"\n",
    "\n",
    "    return \"add\"\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# SMART ORDER PARSER\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "def parse_order(text):\n",
    "\n",
    "    text = preprocess_text(text)\n",
    "\n",
    "    command = detect_command(text)\n",
    "\n",
    "    if command == \"menu\":\n",
    "        return {\n",
    "            \"command\": \"menu\",\n",
    "            \"items\": []\n",
    "        }\n",
    "\n",
    "    \n",
    "\n",
    "    words = re.findall(\n",
    "        r\"[\\w\\u0900-\\u097F\\u0980-\\u09FF]+\",\n",
    "        text.lower()\n",
    "    )\n",
    "\n",
    "    order = []\n",
    "\n",
    "    quantity = None\n",
    "\n",
    "    for word in words:\n",
    "\n",
    "        # ------------------------------\n",
    "        # Quantity\n",
    "        # ------------------------------\n",
    "\n",
    "        q = get_quantity(word)\n",
    "\n",
    "        if q is not None:\n",
    "\n",
    "            quantity = q\n",
    "\n",
    "            continue\n",
    "\n",
    "        # ------------------------------\n",
    "        # Menu Item\n",
    "        # ------------------------------\n",
    "\n",
    "        item = match_item(word)\n",
    "\n",
    "        if item:\n",
    "\n",
    "            if quantity is None:\n",
    "\n",
    "                quantity = 1\n",
    "\n",
    "            order.append({\n",
    "\n",
    "                \"item\": item,\n",
    "\n",
    "                \"display\": MENU[item][\"display\"],\n",
    "\n",
    "                \"price\": MENU[item][\"price\"],\n",
    "\n",
    "                \"quantity\": quantity\n",
    "\n",
    "            })\n",
    "\n",
    "            quantity = None\n",
    "\n",
    "    return {\n",
    "\n",
    "        \"command\": command,\n",
    "\n",
    "        \"items\": order\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# HELPER FUNCTIONS\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "def get_item_name(item_key, language=\"en\"):\n",
    "\n",
    "    if item_key not in MENU:\n",
    "        return item_key\n",
    "\n",
    "    return MENU[item_key][\"display\"].get(\n",
    "        language,\n",
    "        MENU[item_key][\"display\"][\"en\"]\n",
    "    )\n",
    "\n",
    "\n",
    "def format_order(order_data, language=\"en\"):\n",
    "\n",
    "    if not order_data[\"items\"]:\n",
    "\n",
    "        return \"No items found.\"\n",
    "\n",
    "    lines = []\n",
    "\n",
    "    total = 0\n",
    "\n",
    "    for item in order_data[\"items\"]:\n",
    "\n",
    "        subtotal = item[\"price\"] * item[\"quantity\"]\n",
    "\n",
    "        total += subtotal\n",
    "\n",
    "        lines.append(\n",
    "\n",
    "            f\"{item['quantity']} × \"\n",
    "            f\"{get_item_name(item['item'], language)} \"\n",
    "            f\"(₹{item['price']} each = ₹{subtotal})\"\n",
    "\n",
    "        )\n",
    "\n",
    "    lines.append(\"-\" * 35)\n",
    "\n",
    "    lines.append(f\"Total = ₹{total}\")\n",
    "\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# TESTS\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "#                  ORDER MANAGER (CELL 6)\n",
    "# ==========================================================\n",
    "\n",
    "class OrderManager:\n",
    "\n",
    "    def __init__(self):\n",
    "\n",
    "        self.order = []\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Add Items\n",
    "    # ------------------------------------------------------\n",
    "    def add_order(self, parsed_data):\n",
    "\n",
    "        # New parser returns:\n",
    "        # {\n",
    "        #     \"command\": \"...\",\n",
    "        #     \"items\": [...]\n",
    "        # }\n",
    "\n",
    "        new_items = parsed_data[\"items\"]\n",
    "\n",
    "        for new_item in new_items:\n",
    "\n",
    "            found = False\n",
    "\n",
    "            for item in self.order:\n",
    "\n",
    "                if item[\"item\"] == new_item[\"item\"]:\n",
    "\n",
    "                    item[\"quantity\"] += new_item[\"quantity\"]\n",
    "\n",
    "                    found = True\n",
    "\n",
    "                    break\n",
    "\n",
    "            if not found:\n",
    "\n",
    "                    import copy\n",
    "                    \n",
    "                    self.order.append(copy.deepcopy(new_item))\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Remove Item\n",
    "    # ------------------------------------------------------\n",
    "    def remove_item(self, item_name, quantity=1):\n",
    "    \n",
    "        for item in self.order:\n",
    "    \n",
    "            if item[\"item\"] == item_name:\n",
    "    \n",
    "                # Remove whole item if quantity is greater\n",
    "                if quantity >= item[\"quantity\"]:\n",
    "    \n",
    "                    removed_qty = item[\"quantity\"]\n",
    "    \n",
    "                    self.order.remove(item)\n",
    "    \n",
    "                    return removed_qty\n",
    "    \n",
    "                else:\n",
    "    \n",
    "                    item[\"quantity\"] -= quantity\n",
    "    \n",
    "                    return quantity\n",
    "    \n",
    "        return 0\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Update Quantity\n",
    "    # ------------------------------------------------------\n",
    "    def update_quantity(self, item_name, quantity):\n",
    "\n",
    "        for item in self.order:\n",
    "\n",
    "            if item[\"item\"] == item_name:\n",
    "\n",
    "                item[\"quantity\"] = quantity\n",
    "\n",
    "                return True\n",
    "\n",
    "        return False\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Check Empty\n",
    "    # ------------------------------------------------------\n",
    "    def is_empty(self):\n",
    "\n",
    "        return len(self.order) == 0\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Get Order\n",
    "    # ------------------------------------------------------\n",
    "    def get_order(self):\n",
    "\n",
    "        return self.order\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Total Bill\n",
    "    # ------------------------------------------------------\n",
    "    def get_total(self):\n",
    "\n",
    "        total = 0\n",
    "\n",
    "        for item in self.order:\n",
    "\n",
    "            total += item[\"price\"] * item[\"quantity\"]\n",
    "\n",
    "        return total\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Clear Order\n",
    "    # ------------------------------------------------------\n",
    "    def clear_order(self):\n",
    "\n",
    "        self.order = []\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Print Order\n",
    "    # ------------------------------------------------------\n",
    "    def print_order(self, language=\"en\"):\n",
    "\n",
    "        if self.is_empty():\n",
    "\n",
    "            print(\"🛒 Order is empty.\")\n",
    "\n",
    "            return\n",
    "\n",
    "        print(\"\\n========== CURRENT ORDER ==========\")\n",
    "\n",
    "        for item in self.order:\n",
    "\n",
    "            print(\n",
    "\n",
    "                f\"{item['quantity']} x \"\n",
    "\n",
    "                f\"{item['display'].get(language, item['display']['en'])} \"\n",
    "\n",
    "                f\"₹{item['price']}\"\n",
    "\n",
    "            )\n",
    "\n",
    "        print(\"----------------------------------\")\n",
    "\n",
    "        print(f\"Total = ₹{self.get_total()}\")\n",
    "\n",
    "        print(\"==================================\\n\")\n",
    "\n",
