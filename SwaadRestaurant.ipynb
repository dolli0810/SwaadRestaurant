    "# ==========================================================\n",
    "#          ORDER CONFIRMATION SYSTEM (CELL 9)\n",
    "# ==========================================================\n",
    "\n",
    "def check_confirmation(assistant):\n",
    "\n",
    "    response = assistant.listen().lower()\n",
    "\n",
    "    if response == \"\":\n",
    "        return None\n",
    "\n",
    "    yes_words = TEXT[assistant.language][\"yes\"]\n",
    "    no_words = TEXT[assistant.language][\"no\"]\n",
    "\n",
    "    response = re.sub(\n",
    "        r\"[^\\w\\u0900-\\u097F\\u0980-\\u09FF ]\",\n",
    "        \"\",\n",
    "        response\n",
    "    ).strip()\n",
    "\n",
    "    response_words = response.split()\n",
    "\n",
    "    if response in yes_words or any(token in yes_words for token in response_words):\n",
    "        return True\n",
    "\n",
    "    if response in no_words or any(token in no_words for token in response_words):\n",
    "        return False\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def confirm_and_add_order(assistant, order_manager, parsed_order):\n",
    "\n",
    "    while True:\n",
    "\n",
    "        assistant.speak(\n",
    "            TEXT[assistant.language][\"is_correct\"]\n",
    "        )\n",
    "\n",
    "        confirmation = check_confirmation(assistant)\n",
    "\n",
    "        # ---------------- YES ----------------\n",
    "\n",
    "        if confirmation is True:\n",
    "\n",
    "            order_manager.add_order(parsed_order)\n",
    "\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"order_added\"]\n",
    "            )\n",
    "\n",
    "            return True\n",
    "\n",
    "        # ---------------- NO ----------------\n",
    "\n",
    "        elif confirmation is False:\n",
    "\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"repeat\"]\n",
    "            )\n",
    "\n",
    "            new_order = assistant.listen(\n",
    "                timeout=10,\n",
    "                phrase_time_limit=20\n",
    "            )\n",
    "\n",
    "            if new_order == \"\":\n",
    "\n",
    "                assistant.speak(\n",
    "                    TEXT[assistant.language][\"not_understood\"]\n",
    "                )\n",
    "\n",
    "                continue\n",
    "\n",
    "            parsed_order = parse_order(new_order)\n",
    "\n",
    "            if len(parsed_order[\"items\"]) == 0:\n",
    "\n",
    "                assistant.speak(\n",
    "                    TEXT[assistant.language][\"not_understood\"]\n",
    "                )\n",
    "\n",
    "                continue\n",
    "\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"confirm_order\"]\n",
    "            )\n",
    "            \n",
    "            order_sentence = \"\"\n",
    "            \n",
    "            for i, item in enumerate(parsed_order[\"items\"]):\n",
    "            \n",
    "                if i > 0:\n",
    "                    order_sentence += \", \"\n",
    "            \n",
    "                order_sentence += (\n",
    "                    f\"{item['quantity']} \"\n",
    "                    f\"{item['display'][assistant.language]}\"\n",
    "                )\n",
    "            \n",
    "            assistant.speak(order_sentence)\n",
    "            \n",
    "            # loop repeats and asks \"Is this correct?\" again\n",
    "\n",
    "        # ---------------- UNKNOWN ----------------\n",
    "\n",
    "        else:\n",
    "\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"not_understood\"]\n",
    "            )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "#             MULTIPLE ORDER CONVERSATION (CELL 10)\n",
    "# ==========================================================\n",
    "\n",
    "def continue_ordering(assistant, order_manager):\n",
    "\n",
    "    while True:\n",
    "\n",
    "        assistant.speak(\n",
    "            TEXT[assistant.language][\"ask_more\"]\n",
    "        )\n",
    "\n",
    "        response = assistant.listen().lower()\n",
    "\n",
    "        response = re.sub(\n",
    "            r\"[^\\w\\u0900-\\u097F\\u0980-\\u09FF ]\",\n",
    "            \"\",\n",
    "            response\n",
    "        ).strip()\n",
    "\n",
    "        if response == \"\":\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"not_understood\"]\n",
    "            )\n",
    "            continue\n",
    "\n",
    "        # ---------------------------------------\n",
    "        # YES\n",
    "        # ---------------------------------------\n",
    "\n",
    "        yes_words = TEXT[assistant.language][\"yes\"]\n",
    "\n",
    "        response_words = response.split()\n",
    "\n",
    "        if response in yes_words or any(word in response_words for word in yes_words):\n",
    "\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"ask_order\"]\n",
    "            )\n",
    "\n",
    "            new_order_text = assistant.listen(\n",
    "                timeout=10,\n",
    "                phrase_time_limit=20\n",
    "            )\n",
    "\n",
    "            if new_order_text == \"\":\n",
    "                assistant.speak(\n",
    "                    TEXT[assistant.language][\"not_understood\"]\n",
    "                )\n",
    "                continue\n",
    "\n",
    "            parsed_order = parse_order(new_order_text)\n",
    "\n",
    "            if len(parsed_order[\"items\"]) == 0:\n",
    "                assistant.speak(\n",
    "                    TEXT[assistant.language][\"not_understood\"]\n",
    "                )\n",
    "                continue\n",
    "\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"confirm_order\"]\n",
    "            )\n",
    "            \n",
    "            order_sentence = \"\"\n",
    "            \n",
    "            for i, item in enumerate(parsed_order[\"items\"]):\n",
    "            \n",
    "                if i > 0:\n",
    "                    order_sentence += \", \"\n",
    "            \n",
    "                order_sentence += (\n",
    "                    f\"{item['quantity']} \"\n",
    "                    f\"{item['display'][assistant.language]}\"\n",
    "                )\n",
    "\n",
    "            \n",
    "            assistant.speak(order_sentence)\n",
    "\n",
    "            confirm_and_add_order(\n",
    "                assistant,\n",
    "                order_manager,\n",
    "                parsed_order\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "             # ---------------------------------------\n",
    "            # NO\n",
    "            # ---------------------------------------\n",
    "\n",
    "            no_words = TEXT[assistant.language][\"no\"]\n",
    "\n",
    "            response_words = response.split()\n",
    "\n",
    "            if response in no_words or any(word in response_words for word in no_words):\n",
    "\n",
    "                if assistant.language == \"hi\":\n",
    "                    assistant.speak(\n",
    "                        \"ठीक है। मैं आपका अंतिम बिल तैयार करती हूँ।\"\n",
    "                    )\n",
    "\n",
    "                elif assistant.language == \"as\":\n",
    "                    assistant.speak(\n",
    "                        \"ঠিক আছে। মই আপোনাৰ চূড়ান্ত বিল প্ৰস্তুত কৰিছোঁ।\"\n",
    "                    )\n",
    "\n",
    "                else:\n",
    "                    assistant.speak(\n",
    "                        \"Alright. I will prepare your final bill.\"\n",
    "                    )\n",
    "\n",
    "                break\n",
    "            # ---------------------------------------\n",
    "            # Direct Order\n",
    "            # ---------------------------------------\n",
    "\n",
    "            direct_order = parse_order(response)\n",
    "\n",
    "            command = direct_order[\"command\"]\n",
    "            \n",
    "            # ---------------- MENU ----------------\n",
    "            \n",
    "            if command == \"menu\":\n",
    "            \n",
    "                show_menu(assistant)\n",
    "            \n",
    "                continue\n",
    "            \n",
    "            # ---------------- PRICE ----------------\n",
    "            \n",
    "            elif command == \"price\":\n",
    "            \n",
    "                if len(direct_order[\"items\"]) > 0:\n",
    "            \n",
    "                    for item in direct_order[\"items\"]:\n",
    "            \n",
    "                        assistant.speak(\n",
    "            \n",
    "                            f\"{item['display'][assistant.language]} \"\n",
    "            \n",
    "                            f\"{item['price']}\"\n",
    "            \n",
    "                        )\n",
    "            \n",
    "                else:\n",
    "            \n",
    "                    assistant.speak(\n",
    "            \n",
    "                        TEXT[assistant.language][\"not_understood\"]\n",
    "            \n",
    "                    )\n",
    "            \n",
    "                continue\n",
    "            \n",
    "            # ---------------- REMOVE ----------------\n",
    "\n",
    "            elif command == \"remove\":\n",
    "            \n",
    "                removed_any = False\n",
    "            \n",
    "                for item in direct_order[\"items\"]:\n",
    "            \n",
    "                    removed_qty = order_manager.remove_item(\n",
    "                        item[\"item\"],\n",
    "                        item[\"quantity\"]\n",
    "                    )\n",
    "            \n",
    "                    if removed_qty > 0:\n",
    "            \n",
    "                        removed_any = True\n",
    "            \n",
    "                        if removed_qty < item[\"quantity\"]:\n",
    "            \n",
    "                            if assistant.language == \"hi\":\n",
    "            \n",
    "                                assistant.speak(\n",
    "                                    f\"आपके ऑर्डर में केवल {removed_qty} {item['display']['hi']} था। उसे हटा दिया गया है।\"\n",
    "                                )\n",
    "            \n",
    "                            elif assistant.language == \"as\":\n",
    "            \n",
    "                                assistant.speak(\n",
    "                                    f\"আপোনাৰ অৰ্ডাৰত কেৱল {removed_qty}টা {item['display']['as']} আছিল। আঁতৰোৱা হৈছে।\"\n",
    "                                )\n",
    "            \n",
    "                            else:\n",
    "            \n",
    "                                assistant.speak(\n",
    "                                    f\"Only {removed_qty} {item['display']['en']} was in your order. It has been removed.\"\n",
    "                                )\n",
    "            \n",
    "                        else:\n",
    "            \n",
    "                            assistant.speak(\n",
    "                                TEXT[assistant.language][\"item_removed\"]\n",
    "                            )\n",
    "            \n",
    "                    else:\n",
    "            \n",
    "                        if assistant.language == \"hi\":\n",
    "            \n",
    "                            assistant.speak(\n",
    "                                f\"{item['display']['hi']} आपके ऑर्डर में नहीं है।\"\n",
    "                            )\n",
    "            \n",
    "                        elif assistant.language == \"as\":\n",
    "            \n",
    "                            assistant.speak(\n",
    "                                f\"{item['display']['as']} আপোনাৰ অৰ্ডাৰত নাই।\"\n",
    "                            )\n",
    "            \n",
    "                        else:\n",
    "            \n",
    "                            assistant.speak(\n",
    "                                f\"{item['display']['en']} is not in your order.\"\n",
    "                            )\n",
    "            \n",
    "                if removed_any:\n",
    "            \n",
    "                    order_manager.print_order(\n",
    "                        assistant.language\n",
    "                    )\n",
    "            \n",
    "                continue\n",
    "            \n",
    "            # ---------------- ADD ----------------\n",
    "            \n",
    "            elif command == \"add\":\n",
    "            \n",
    "                if len(direct_order[\"items\"]) > 0:\n",
    "            \n",
    "                    assistant.speak(\n",
    "                        TEXT[assistant.language][\"confirm_order\"]\n",
    "                    )\n",
    "                    \n",
    "                    order_sentence = \"\"\n",
    "                    \n",
    "                    for i, item in enumerate(direct_order[\"items\"]):\n",
    "                    \n",
    "                        if i > 0:\n",
    "                            order_sentence += \", \"\n",
    "                    \n",
    "                        order_sentence += (\n",
    "                            f\"{item['quantity']} \"\n",
    "                            f\"{item['display'][assistant.language]}\"\n",
    "                        )\n",
    "                    \n",
    "                    assistant.speak(order_sentence)\n",
    "                    \n",
    "                    \n",
    "            \n",
    "                    confirm_and_add_order(\n",
    "            \n",
    "                        assistant,\n",
    "            \n",
    "                        order_manager,\n",
    "            \n",
    "                        direct_order\n",
    "            \n",
    "                    )\n",
    "            \n",
    "                continue\n",
    "\n",
    "            # ---------------------------------------\n",
    "            # Unknown\n",
    "            # ---------------------------------------\n",
    "\n",
    "            assistant.speak(\n",
    "                TEXT[assistant.language][\"not_understood\"]\n",
    "            )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "#                 BILLING SYSTEM (CELL 11)\n",
    "# ==========================================================\n",
    "\n",
    "\n",
    "def generate_bill(assistant, order_manager):\n",
    "\n",
    "    lang = assistant.language\n",
    "    \n",
    "    if order_manager.is_empty():\n",
    "\n",
    "        return TEXT[lang][\"empty_order\"]\n",
    "\n",
    "\n",
    "    # ---------------- BILL HEADER ----------------\n",
    "\n",
    "    if lang == \"hi\":\n",
    "    \n",
    "        print(\"\\n=============================================\")\n",
    "        print(\"            स्वाद रेस्टोरेंट\")\n",
    "        print(\"              अंतिम बिल\")\n",
    "        print(\"=============================================\")\n",
    "    \n",
    "    \n",
    "    elif lang == \"as\":\n",
    "    \n",
    "        print(\"\\n=============================================\")\n",
    "        print(\"          Swaad ৰেষ্টুৰেণ্ট\")\n",
    "        print(\"             চূড়ান্ত বিল\")\n",
    "        print(\"=============================================\")\n",
    "    \n",
    "    \n",
    "    else:\n",
    "    \n",
    "        print(\"\\n=============================================\")\n",
    "        print(\"             SWAAD RESTAURANT\")\n",
    "        print(\"                FINAL BILL\")\n",
    "        print(\"=============================================\")\n",
    "\n",
    "\n",
    "    total = 0\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- ITEMS ----------------\n",
    "\n",
    "    for item in order_manager.order:\n",
    "\n",
    "\n",
    "        amount = item[\"quantity\"] * item[\"price\"]\n",
    "\n",
    "        total += amount\n",
    "\n",
    "\n",
    "\n",
    "        item_name = item[\"display\"].get(\n",
    "            lang,\n",
    "            item[\"display\"][\"en\"]\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "        print(\n",
    "            f'{item[\"quantity\"]} x {item_name}  ₹{amount}'\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "    print(\"---------------------------------------------\")\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- TOTAL ----------------\n",
    "\n",
    "    if lang == \"hi\":\n",
    "\n",
    "        print(\n",
    "            f\"कुल राशि : ₹{total}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif lang == \"as\":\n",
    "\n",
    "        print(\n",
    "            f\"মুঠ পৰিমাণ : ₹{total}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        print(\n",
    "            f\"Total Amount : ₹{total}\"\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "    print(\"=============================================\")\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- VOICE MESSAGE ----------------\n",
    "\n",
    "\n",
    "    if lang == \"hi\":\n",
    "\n",
    "        bill_voice = (\n",
    "            f\"आपका अंतिम बिल तैयार है। \"\n",
    "            f\"कुल राशि {total} रुपये है।\"\n",
    "        )\n",
    "    \n",
    "    \n",
    "    elif lang == \"as\":\n",
    "    \n",
    "        bill_voice = (\n",
    "            f\"আপোনাৰ চূড়ান্ত বিল প্ৰস্তুত। \"\n",
    "            f\"মুঠ পৰিমাণ {total} টকা।\"\n",
    "        )\n",
    "    \n",
    "    \n",
    "    else:\n",
    "    \n",
    "        bill_voice = (\n",
    "            f\"Your final bill is ready. \"\n",
    "            f\"Your total amount is {total} rupees.\"\n",
    "        )\n",
    "    \n",
    "    \n",
    "    \n",
    "    \n",
    "    return bill_voice\n",
    "\n",
    "# ==========================================================\n",
    "#          FINAL RESTAURANT ASSISTANT PROGRAM (CELL 12)\n",
    "# ==========================================================\n",
    "\n",
    "\n",
    "def show_menu(assistant):\n",
    "\n",
    "    assistant.speak(\n",
    "        TEXT[assistant.language][\"menu_intro\"]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\"\\n========== MENU ==========\")\n",
    "\n",
    "    menu_text = \"\"\n",
    "\n",
    "\n",
    "    for item in MENU:\n",
    "\n",
    "        name = MENU[item][\"display\"][assistant.language]\n",
    "\n",
    "        price = MENU[item][\"price\"]\n",
    "\n",
    "\n",
    "        print(\n",
    "            f\"{name} - ₹{price}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        if assistant.language == \"en\":\n",
    "\n",
    "            menu_text += (\n",
    "                f\"{name} costs {price} rupees. \"\n",
    "            )\n",
    "        \n",
    "        elif assistant.language == \"hi\":\n",
    "        \n",
    "            menu_text += (\n",
    "                f\"{name} की कीमत {price} रुपये है। \"\n",
    "            )\n",
    "        \n",
    "        else:\n",
    "        \n",
    "            menu_text += (\n",
    "                f\"{name}ৰ দাম {price} টকা। \"\n",
    "            )\n",
    "\n",
    "\n",
    "    print(\"==========================\\n\")\n",
    "\n",
    "\n",
    "    assistant.speak(menu_text)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "def start_restaurant():\n",
    "\n",
    "    assistant = RestaurantAssistant()\n",
    "\n",
    "    order_manager = OrderManager()\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- Welcome ----------------\n",
    "\n",
    "    assistant.speak(\n",
    "        TEXT[\"en\"][\"welcome\"]\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- Language ----------------\n",
    "\n",
    "    select_language(assistant)\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- Menu ----------------\n",
    "\n",
    "    show_menu(assistant)\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- First Order ----------------\n",
    "\n",
    "    assistant.speak(\n",
    "        TEXT[assistant.language][\"ask_order\"]\n",
    "    )\n",
    "\n",
    "\n",
    "    while True:\n",
    "\n",
    "        order_text = assistant.listen()\n",
    "    \n",
    "        if order_text != \"\":\n",
    "            break\n",
    "    \n",
    "        assistant.speak(\n",
    "            TEXT[assistant.language][\"not_understood\"]\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    parsed_order = parse_order(order_text)\n",
    "\n",
    "\n",
    "\n",
    "    if len(parsed_order[\"items\"]) == 0:\n",
    "\n",
    "\n",
    "        assistant.speak(\n",
    "            TEXT[assistant.language][\"not_understood\"]\n",
    "        )\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- Confirmation ----------------\n",
    "\n",
    "    assistant.speak(\n",
    "        TEXT[assistant.language][\"confirm_order\"]\n",
    "    )\n",
    "    \n",
    "    order_sentence = \"\"\n",
    "    \n",
    "    for i, item in enumerate(parsed_order[\"items\"]):\n",
    "    \n",
    "        if i > 0:\n",
    "            order_sentence += \", \"\n",
    "    \n",
    "        order_sentence += (\n",
    "            f\"{item['quantity']} \"\n",
    "            f\"{item['display'][assistant.language]}\"\n",
    "        )\n",
    "    \n",
    "    assistant.speak(order_sentence)\n",
    "    \n",
    "    confirm_and_add_order(\n",
    "        assistant,\n",
    "        order_manager,\n",
    "        parsed_order\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- More Orders ----------------\n",
    "\n",
    "    continue_ordering(\n",
    "\n",
    "        assistant,\n",
    "\n",
    "        order_manager\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    # ---------------- Bill ----------------\n",
    "    \n",
    "\n",
    "    bill_text = generate_bill(\n",
    "\n",
    "        assistant,\n",
    "\n",
    "        order_manager\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "    assistant.speak(bill_text)\n",
    "    \n",
    "    assistant.speak(\n",
    "        TEXT[assistant.language][\"thank_you\"]\n",
    "    )\n",
    "    \n",
    "    assistant.speak(\n",
    "        TEXT[assistant.language][\"goodbye\"]\n",
    "    )\n",
    "    \n",
    "\n",
    "start_restaurant()"
   ]
  }
 ],
